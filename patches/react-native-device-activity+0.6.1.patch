+import DeviceActivity
+import ExpoModulesCore
+import FamilyControls
+import SwiftUI
+import UIKit
+
+// Wraps Apple's `DeviceActivityReport` SwiftUI view so it can be rendered
+// from React Native. Mounting the view causes iOS to launch the matching
+// DeviceActivityReport Extension (registered in the host app), which can then
+// aggregate Screen Time data and persist it to App Group UserDefaults.
+@available(iOS 16.0, *)
+class ReactNativeDeviceActivityReportView: ExpoView {
+
+  // The SwiftUI host. Recreated when contextName/days change so iOS reruns the extension.
+  private var contentView: UIHostingController<AnyView>!
+
+  // Configurable props
+  private var contextName: String = "Total Activity"
+  private var days: Int = 7
+
+  required init(appContext: AppContext? = nil) {
+    super.init(appContext: appContext)
+    backgroundColor = .clear
+    rebuildContent()
+  }
+
+  override func layoutSubviews() {
+    contentView.view.frame = bounds
+  }
+
+  override func didMoveToWindow() {
+    super.didMoveToWindow()
+    if window != nil {
+      if contentView.parent == nil, let parentVC = parentViewController {
+        parentVC.addChild(contentView)
+        contentView.didMove(toParent: parentVC)
+      }
+    } else if contentView.parent != nil {
+      contentView.willMove(toParent: nil)
+      contentView.removeFromParent()
+    }
+  }
+
+  private var parentViewController: UIViewController? {
+    var responder: UIResponder? = self
+    while let next = responder?.next {
+      if let vc = next as? UIViewController { return vc }
+      responder = next
+    }
+    return nil
+  }
+
+  // MARK: Props
+
+  func setContextName(_ name: String) {
+    if name != contextName {
+      contextName = name
+      rebuildContent()
+    }
+  }
+
+  func setDays(_ d: Int) {
+    if d != days {
+      days = d
+      rebuildContent()
+    }
+  }
+
+  private func rebuildContent() {
+    let calendar = Calendar.current
+    let now = Date()
+    let start =
+      calendar.date(byAdding: .day, value: -max(1, days), to: now) ?? now
+    let interval = DateInterval(start: start, end: now)
+
+    let filter = DeviceActivityFilter(
+      segment: .daily(during: interval),
+      users: .all,
+      devices: .init([.iPhone])
+    )
+
+    let context = DeviceActivityReport.Context(rawValue: contextName)
+    let view = AnyView(
+      DeviceActivityReport(context, filter: filter)
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+    )
+
+    if contentView == nil {
+      contentView = UIHostingController(rootView: view)
+      contentView.view.backgroundColor = .clear
+      contentView.view.isUserInteractionEnabled = false
+      addSubview(contentView.view)
+    } else {
+      contentView.rootView = view
+    }
+    setNeedsLayout()
+  }
+}
